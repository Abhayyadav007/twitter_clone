# --- Rust / Cargo ---
/target/
**/target/
Cargo.lock       # only ignore this if you're building a library; for binaries/services, COMMIT it

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- sqlx ---
# If you use `cargo sqlx prepare` with offline mode, KEEP .sqlx/ committed
# (don't ignore it — it's needed for CI builds without a live DB)

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- macOS ---
.DS_Store

# --- Logs / debug ---
*.log
debug/

# --- Docker ---
docker-compose.override.yml

# --- If workspace has a frontend (Leptos/Trunk) ---
/dist/
node_modules/
